# ==========================================
# Haan Hosting Instagram Agent - Environment
# Copy this file to .env and fill in values.
# NEVER commit .env to version control!
# ==========================================

# --- Primary AI Provider (Google Gemini - Free from aistudio.google.com) ---
GEMINI_API_KEY=

# --- Secondary AI Providers (Free tiers) ---
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Instagram Graph API (Official Meta Instagram Login) ---
# System-user token (EAA..., never expires) from Meta Business Settings
IG_ACCESS_TOKEN=
# Numeric Instagram Business / Creator User ID
IG_USER_ID=

# --- Public Media Hosting (Cloudflare Pages) ---
PAGES_BASE_URL=https://haan-agent.pages.dev
GITHUB_REPOSITORY=username/haan-insta-agent

# --- GitHub Secret Updating (Weekly Token Auto-Refresh Workflow) ---
# Fine-grained Personal Access Token with Secrets:write permission on this repo
GH_PAT=

